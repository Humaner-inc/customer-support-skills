{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Humaner-inc/customer-support-skills/.schemas/skill.schema.json",
  "title": "Skill frontmatter (SKILL.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase-with-hyphens identifier (e.g. retail-core, wellness-escalation)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    }
  }
}
