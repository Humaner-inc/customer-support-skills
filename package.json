{
  "name": "@humaner/customer-support-skillz",
  "version": "0.3.0",
  "description": "An open source library of customer-support industry how-tos. Each industry folder teaches behavior and common issues before ingesting your own KBs.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json"
  },
  "files": [
    "dist",
    "industries",
    "SPEC.md"
  ],
  "scripts": {
    "prepare": "node eng/build.js",
    "prepublishOnly": "npm run validate && npm run build",
    "validate": "node eng/validate.js",
    "build": "node eng/build.js",
    "fix-line-endings": "node eng/fix-line-endings.js",
    "pretest": "npm run validate",
    "test": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Humaner-inc/customer-support-skillz.git"
  },
  "homepage": "https://github.com/Humaner-inc/customer-support-skillz#readme",
  "bugs": {
    "url": "https://github.com/Humaner-inc/customer-support-skillz/issues"
  },
  "keywords": [
    "customer-support",
    "ai-agents",
    "skillz",
    "prompt-engineering",
    "humaner"
  ]
}
